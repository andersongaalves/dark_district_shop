# Copie somente se backend/.env ainda não existir. Nunca versione credenciais.
# Preencha DATABASE_URL e SECRET_KEY antes de iniciar a aplicação.
DATABASE_URL=postgresql://dd:SUBSTITUA_A_SENHA@127.0.0.1:5432/dark_district
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://[::1]:5500","https://darkdistrict.com.br","https://www.darkdistrict.com.br","https://dark-district-shop.andersongaalves1.workers.dev"]
LOGIN_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=1048576
MAX_LOGIN_BODY_BYTES=16384

# Web Chat: o modo disabled do LLM permite testar buscas simples sem serviço externo.
CHAT_ENABLED=true
CHAT_SESSION_HOURS=24
CHAT_MAX_MESSAGE_LENGTH=2000
CHAT_HISTORY_MESSAGES=12
CHAT_MAX_PRODUCTS=5
CHAT_REQUESTS_PER_MINUTE=15
CHAT_GLOBAL_REQUESTS_PER_MINUTE=120
CHAT_SESSIONS_PER_HOUR=10
CHAT_MAX_MESSAGES_PER_SESSION=200
CHAT_PROCESSING_LEASE_SECONDS=120
CHAT_RETENTION_DAYS=30
# Local: http://localhost:5500/; produção: URL HTTPS pública da loja.
STOREFRONT_URL=http://localhost:5500/

# Providers: disabled | openai_compatible
# O modelo escolhido precisa suportar Chat Completions, strict tools e max_completion_tokens.
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=600
LLM_MAX_TOOL_CALLS=4

# Ative apenas após configurar o aplicativo Meta e um worker separado.
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Use a versão habilitada no aplicativo Meta, no formato vNN.0.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_HTTP_TIMEOUT_SECONDS=15
DELIVERY_LEASE_SECONDS=180
DELIVERY_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=2

# Somente para o PostgreSQL local opcional do compose.yaml.
# Deve coincidir com a senha da DATABASE_URL acima. Use senha aleatória URL-safe.
DD_POSTGRES_PASSWORD=

# create_admin.py lê ADMIN_USERNAME e ADMIN_PASSWORD do ambiente do processo.
# Configurá-los aqui não os exporta para o processo automaticamente.
