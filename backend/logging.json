{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {"support": {"format": "%(asctime)s %(levelname)s %(name)s %(message)s"}},
  "handlers": {"console": {"class": "logging.StreamHandler", "formatter": "support", "stream": "ext://sys.stdout"}},
  "root": {"level": "WARNING", "handlers": ["console"]},
  "loggers": {
    "uvicorn": {"level": "INFO", "handlers": ["console"], "propagate": false},
    "uvicorn.access": {"level": "INFO", "handlers": ["console"], "propagate": false},
    "services": {"level": "INFO", "handlers": ["console"], "propagate": false},
    "tools": {"level": "INFO", "handlers": ["console"], "propagate": false},
    "integrations.llm": {"level": "INFO", "handlers": ["console"], "propagate": false},
    "routers.whatsapp": {"level": "INFO", "handlers": ["console"], "propagate": false}
  }
}
